# Upstream SHA-256 checksums for the pinned Bun runtime.
#
# Copied verbatim from
# https://github.com/oven-sh/bun/releases/download/bun-v1.3.11/SHASUMS256.txt.
# scripts/stage-release.sh verifies every Bun archive it stages against these
# values, so a tampered mirror or a truncated download can never reach a
# machine — and install.sh then re-verifies against the manifest generated from
# these same bytes. This is the same discipline task .4 applied to Node; GNO
# (D8) runs on Bun, so Bun is a prerequisite with the same standing.
#
# Only the four non-baseline, non-profile archives Homeplane targets are pinned.
# Bumping Bun: replace every line here with the new release's upstream
# checksums AND the BUN_VERSION default in install.sh (a test asserts they
# agree).
#
# Bun's release assets are NOT version-named (`bun-darwin-aarch64.zip` is the
# same file name in every release), so unlike the Node pin the version cannot be
# derived from the checksummed names and is stated here explicitly. Staged
# artifacts are renamed to include it.
version = 1.3.11
6f5a3467ed9caec4795bf78cd476507d9f870c7d57b86c945fcb338126772ffc  bun-darwin-aarch64.zip
c4fe2b9247218b0295f24e895aaec8fee62e74452679a9026b67eacbd611a286  bun-darwin-x64.zip
d13944da12a53ecc74bf6a720bd1d04c4555c038dfe422365356a7be47691fdf  bun-linux-aarch64.zip
8611ba935af886f05a6f38740a15160326c15e5d5d07adef966130b4493607ed  bun-linux-x64.zip
