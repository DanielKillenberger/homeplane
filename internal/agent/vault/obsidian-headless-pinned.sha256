# Pinned obsidian-headless CLI: exact version + SHA-256 of the executable.
#
# WHY A PIN AT ALL. Obsidian Sync rewrites the vault in place. An upstream
# data-loss report against obsidian-headless 0.0.12 is the reason this file
# exists: the agent will only ever run the ONE build that was smoke-tested on a
# disposable vault, never "whatever `ob` happens to be on PATH".
#
# FAIL-CLOSED. `checksum` below is the literal token PENDING until a release has
# been staged and verified for this repository. While it is PENDING, sync
# activation REFUSES to run (vault.ErrPinUnset) — it does not fall back to an
# unverified binary. Task .7's live proof is what fills it in.
#
# Bumping the pin:
#   1. Download the release, verify it against upstream's published checksum.
#   2. Smoke it on a DISPOSABLE vault (scripts run this automatically before any
#      real-vault activation).
#   3. Put the new version + `shasum -a 256` of the executable here.
#
# Format: `key = value`, one per line, `#` comments ignored.

version = 0.0.13
checksum = PENDING
