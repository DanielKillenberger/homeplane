# Generated by homeplane-agent. Do not edit: re-render from internal/agent/supervise.
[Unit]
Description={{ .Description }}
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart={{ .Program | shell }}{{ range .Args }} {{ . | shell }}{{ end }}
{{- if .WorkingDir }}
WorkingDirectory={{ .WorkingDir }}
{{- end }}
{{- range $k, $v := .Env }}
Environment={{ printf "%s=%s" $k $v | quote }}
{{- end }}
Restart={{ if .KeepAlive }}always{{ else }}on-failure{{ end }}
RestartSec={{ .ThrottleSeconds }}
{{- if .StdoutPath }}
StandardOutput=append:{{ .StdoutPath }}
{{- end }}
{{- if .StderrPath }}
StandardError=append:{{ .StderrPath }}
{{- end }}

[Install]
WantedBy=default.target
