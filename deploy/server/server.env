# Homeplane server configuration for THIS deployment (clawniel, Daniel's VPS).
#
# Committed on purpose: Homeplane is a single-server personal system, and the
# shape of its one deployment is not a secret — it is the thing a future
# re-install has to reproduce. Nothing secret is allowed in here (see
# server.env.example for what goes where instead).

HOMEPLANE_HOSTNAME=homeplane
HOMEPLANE_ADDR=:80
HOMEPLANE_TAILNET_FQDN=homeplane.tailab4e9b.ts.net
HOMEPLANE_GATEWAY_PORT=44022
HOMEPLANE_GATEWAY_NAME=homeplane-gateway

# The Google connector (D18: Drive read-only, Calendar read/write), pinned to
# the version the manifest's tool_inventory was captured from. A connector
# upgrade is a manifest change too — the engine refuses to register a manifest
# whose inventory does not cover what the workload advertises.
HOMEPLANE_GATEWAY_WORKLOAD=uvx://workspace-mcp@1.24.0

# Where the server materializes the brokered Google credential, and whose it is.
# The directory lives under var/ so it survives upgrades with the rest of the
# credential state; the account is the one consented in `add-credentials` and the
# one callers name in `user_google_email` — the connector looks the file up by it.
HOMEPLANE_WORKLOAD_CREDENTIAL_DIR=/home/claw/homeplane/var/workload-creds
HOMEPLANE_WORKLOAD_CREDENTIAL_ACCOUNT=daniel.killenberger@gmail.com

# workspace-mcp's image runs as appuser (uid/gid 999). Under rootless Podman that
# maps to a subordinate gid of this host user, so a 0600 file the server owns is
# unreadable by the connector. This makes the credential directory setgid to the
# mapped group and the credential 0640 — reachable by the server and the
# connector, and by nothing else on the host.
HOMEPLANE_WORKLOAD_CREDENTIAL_GID=999

# The connector's own requirements, verified live in the D6 spike and the
# fn-1.12 proof:
#   --build-with PySocks   ToolHive routes container egress through a Squid
#                          proxy advertised in HTTP(S)_PROXY; httplib2 (which
#                          the Google client libraries use) honors those
#                          variables ONLY when PySocks is importable, and
#                          otherwise fails with "Network is unreachable".
#   WORKSPACE_MCP_HOST     the server binds 127.0.0.1 INSIDE its own container
#                          by default, which ToolHive's ingress cannot reach.
#   /creds + --volume      where the credential above is mounted, read-only to
#                          everything outside this host's own user.
HOMEPLANE_GATEWAY_RUN_ARGS="--transport streamable-http --target-port 8000 --build-with PySocks -e WORKSPACE_MCP_HOST=0.0.0.0 -e WORKSPACE_MCP_CREDENTIALS_DIR=/creds -e MCP_SINGLE_USER_MODE=1 --volume ${HOMEPLANE_WORKLOAD_CREDENTIAL_DIR}:/creds"

# The workload's own argv. `--tools drive calendar` is what makes the manifest's
# tool_inventory complete: narrowing it further would hide the Drive write tools
# whose refusal IS the D18 proof.
HOMEPLANE_GATEWAY_WORKLOAD_ARGS="-- --transport streamable-http --tools drive calendar"
