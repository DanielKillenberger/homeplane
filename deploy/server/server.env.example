# Homeplane server deployment configuration.
#
# Copy to server.env, edit, and pass to install-server.sh (or let deploy.sh ship
# it). It is installed at <prefix>/etc/server.env with mode 0600 and is the
# single source of truth for the rendered systemd units: install-server.sh reads
# it, and a re-run with no --config reuses the installed copy, so an upgrade
# cannot silently change the deployment's shape.
#
# NOTHING SECRET BELONGS IN THIS FILE. The tailnet auth key travels in its own
# 0600 file (--authkey-file, installed as <prefix>/etc/authkey.env); provider
# credentials live in the age-encrypted store and are imported with
# `homeplane-server admin secret import`.

# tsnet node name. The server joins the tailnet as its OWN node under this
# hostname — it does not share the host's tailscaled identity.
HOMEPLANE_HOSTNAME=homeplane

# Address the control plane listens on WITHIN the tailnet. This is a tsnet
# (userspace) listener: it never binds a host port, so no privileged port
# problem and nothing is exposed on the host's own interfaces.
HOMEPLANE_ADDR=:80

# The MagicDNS name of the tsnet node above, used to build the endpoint URL
# handed to every harness with its grant. It must resolve to the homeplane node,
# not to the host.
HOMEPLANE_TAILNET_FQDN=homeplane.example-tailnet.ts.net

# Loopback port of the composed gateway (ToolHive workload proxy). It is bound
# to 127.0.0.1 only — that binding IS the bypass boundary, so the only route to
# the gateway from another tailnet node runs through the Homeplane edge.
HOMEPLANE_GATEWAY_PORT=44022

# The workload ToolHive supervises, as `thv run` understands it (registry name,
# image reference, or protocol scheme). `fetch` is the pinned server from the D6
# spike — a real containerized MCP workload with no credential of its own, which
# is what a deployment runs before its first connector is wired.
HOMEPLANE_GATEWAY_WORKLOAD=fetch

# Name ToolHive registers the workload under (also the systemd unit's cleanup
# handle).
HOMEPLANE_GATEWAY_NAME=homeplane-gateway

# Extra `thv run` flags the connector needs (transport shape, build
# dependencies, environment, volumes), and the workload's own argv after `--`.
# Both are optional; a workload that needs neither leaves them empty. What they
# may NOT contain is anything that would move the workload proxy off loopback:
# that binding is the bypass boundary and the unit pins it.
HOMEPLANE_GATEWAY_RUN_ARGS=""
HOMEPLANE_GATEWAY_WORKLOAD_ARGS=""

# Credential delivery. Set BOTH or neither: the server materializes the brokered
# provider credential into this directory in the shape the manifest's
# `credential_delivery.format` names, and the connector looks it up by account.
# Nothing secret goes here — this is a path and an address, not a credential.
HOMEPLANE_WORKLOAD_CREDENTIAL_DIR=""
HOMEPLANE_WORKLOAD_CREDENTIAL_ACCOUNT=""
